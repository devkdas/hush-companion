# Optional default provider configuration.
# User-entered Gemini keys are stored only in browser localStorage.
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_OLLAMA_MODEL=gemma3:4b
# Use http://localhost:3000 with the optional API proxy,
# or http://localhost:11434 for direct Ollama.
VITE_API_URL=http://localhost:3000
# Optional local Kokoro/API proxy URL for text-to-speech. Leave unset to use browser speech.
VITE_TTS_URL=
